# === 服务配置 ===
SERVER_PORT=8080

# === MySQL（本地）===
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/car?parseTime=True&charset=utf8mb4&loc=Local

# === Redis（本地）===
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# === 安全（生产请更换）===
JWT_SECRET=change-me-user-secret
VEHICLE_SECRET=change-me-vehicle-secret

# === 超时与扫描（演示可缩短）===
# 版本发布后超过该秒数无有效回执则判定超时（默认 60）
TIMEOUT_SECONDS=60
# 超时扫描周期（秒），默认 5
SCAN_INTERVAL_SECONDS=5

# === 前端构建产物目录（由后端静态托管）===
WEB_DIST=frontend/dist

# === 系统时间注入（演示/测试用，RFC3339；留空=真实时间）===
# APP_NOW=2026-11-13T10:00:00+08:00
